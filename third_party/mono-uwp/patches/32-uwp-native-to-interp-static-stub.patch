--- a/mono/mini/interp/interp.c
+++ b/mono/mini/interp/interp.c
@@ -1052,6 +1052,56 @@
 static MonoFuncV mono_native_to_interp_trampoline = NULL;
 #endif
 
+#if G_HAVE_API_SUPPORT(HAVE_UWP_WINAPI_SUPPORT)
+/* Precompiled native->interp transition (third_party/mono-uwp/asm/win64.S):
+ * image-backed static code implementing the same CallContext transition
+ * that mono_arch_get_native_to_interp_trampoline would otherwise
+ * JIT-generate. The UWP AppContainer forbids executing dynamically
+ * generated code, so the JIT trampoline (and the JIT ftnptr arg
+ * trampoline below) would be killed on first execution (first delegate
+ * passed to native code). */
+extern void mono_native_to_interp_trampoline_static (void);
+/* Fixed pool of ftnptr entry thunks in win64.S (see there for the layout).
+ * Each thunk loads mono_ftnptr_table[i] into r10 (MONO_ARCH_RGCTX_REG)
+ * and jumps to mono_native_to_interp_trampoline_static. */
+extern guint8 mono_ftnptr_thunks [];
+extern gpointer mono_ftnptr_table [];
+
+/* Number of ftnptr thunks in asm/win64.S; must match the .rept count there.
+ * Each thunk is 12 bytes (7-byte RIP-relative load + 5-byte jmp); the size
+ * is verified by disassembly after the build (see mono-static-stubs.md). */
+#define MONO_UWP_FTNPTR_COUNT 256
+#define MONO_UWP_FTNPTR_THUNK_SIZE 12
+
+static gint32 mono_uwp_ftnptr_next = 0;
+
+/*
+ * mono_uwp_alloc_ftnptr_thunk:
+ *
+ *   Static replacement for mono_create_ftnptr_arg_trampoline (which
+ *   JIT-generates a mov-r10/jmp trampoline per descriptor). Hands out
+ *   the next thunk from the fixed pool in win64.S, stores FTNDESC in
+ *   its table slot, and returns the thunk address, which native code
+ *   calls as the delegate's function pointer. The descriptor is never
+ *   freed (same as the JIT path), so a slot stays valid for the
+ *   lifetime of the process. Aborts loudly if the pool runs out --
+ *   that means more distinct delegate methods were passed to native
+ *   code than the pool holds; bump MONO_UWP_FTNPTR_COUNT here and the
+ *   .rept count in win64.S together.
+ */
+static gpointer
+mono_uwp_alloc_ftnptr_thunk (MonoFtnDesc *ftndesc)
+{
+	gint32 slot = mono_atomic_inc_i32 (&mono_uwp_ftnptr_next) - 1;
+
+	if (slot < 0 || slot >= MONO_UWP_FTNPTR_COUNT)
+		g_error ("UWP ftnptr thunk pool exhausted (%d slots); increase MONO_UWP_FTNPTR_COUNT in interp.c and win64.S", MONO_UWP_FTNPTR_COUNT);
+	mono_ftnptr_table [slot] = ftndesc;
+	mono_memory_barrier ();
+	return (gpointer)(mono_ftnptr_thunks + slot * MONO_UWP_FTNPTR_THUNK_SIZE);
+}
+#endif
+
