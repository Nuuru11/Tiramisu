 }
+#else
+gpointer
+ves_icall_System_Security_Principal_WindowsIdentity_GetCurrentToken (MonoError *error)
+{
+	g_unsupported_api ("OpenThreadToken");
+	mono_error_set_not_supported (error, G_UNSUPPORTED_API, "OpenThreadToken");
+	SetLastError (ERROR_NOT_SUPPORTED);
+	return NULL;
+}
+
+gint32
+mono_security_win_get_token_name (gpointer token, gunichar2 **uniname, MonoError *error)
+{
+	/* UWP: no token APIs. GetTokenName (unguarded, below) treats a 0
+	 * size with no error set as an empty name, which is the graceful
+	 * answer here — so return 0 without setting the error. */
+	return 0;
+}
