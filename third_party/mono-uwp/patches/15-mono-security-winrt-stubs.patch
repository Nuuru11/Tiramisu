# 15: mono/metadata/mono-security.c + mono-security-windows.c — UWP
# stubs for the WindowsIdentity / WindowsImpersonationContext /
# KeyPairPersistence security icalls and helpers.
#
# Windows token and ACL APIs (OpenThreadToken, GetTokenInformation,
# DuplicateToken, ImpersonateLoggedOnUser, RevertToSelf,
# Get/SetNamedSecurityInfo) are desktop-only, so their implementations
# are classic-gated — but icall-def.h references the icalls
# unconditionally, and the UNGUARDED KeyPairPersistence icalls call
# the gated ACL helpers, so the UWP link failed on all of them. The
# stubs report NotSupported, except mono_security_win_get_token_name,
# which returns 0 (GetTokenName treats that as an empty name — the
# graceful answer for WindowsIdentity.Name under UWP). The desktop
# path is unchanged.
--- a/mono/metadata/mono-security.c
+++ b/mono/metadata/mono-security.c
@@ -406,6 +406,24 @@
 	return geteuid () == suid;
 #endif
 }
+#else
+MonoBoolean
+ves_icall_System_Security_Principal_WindowsImpersonationContext_SetCurrentToken (gpointer token, MonoError *error)
+{
+	g_unsupported_api ("ImpersonateLoggedOnUser");
+	mono_error_set_not_supported (error, G_UNSUPPORTED_API, "ImpersonateLoggedOnUser");
+	SetLastError (ERROR_NOT_SUPPORTED);
+	return FALSE;
+}
+
+MonoBoolean
+ves_icall_System_Security_Principal_WindowsImpersonationContext_RevertToSelf (MonoError *error)
+{
+	g_unsupported_api ("RevertToSelf");
+	mono_error_set_not_supported (error, G_UNSUPPORTED_API, "RevertToSelf");
+	SetLastError (ERROR_NOT_SUPPORTED);
+	return FALSE;
+}
 #endif /* G_HAVE_API_SUPPORT(HAVE_CLASSIC_WINAPI_SUPPORT) */
 
