# 06: mono/mini/exceptions-amd64.c — don't install the vectored
# exception handler under UWP.
#
# AddVectoredExceptionHandler / RemoveVectoredExceptionHandler are
# desktop-only APIs, not declared under the UWP (APP) WINAPI family.
# The vectored handler (seh_vectored_exception_handler) serves JIT
# implicit null-checks: it catches hardware faults in JIT-compiled
# code. In interpreter mode no JIT code runs (the interpreter checks
# nulls explicitly), so the VEH is not needed on the console.
# SetUnhandledExceptionFilter IS declared under APP and is left alone,
# so the top-level filter (seh_unhandled_exception_filter) still
# installs.
--- a/mono/mini/exceptions-amd64.c
+++ b/mono/mini/exceptions-amd64.c
@@ -202,7 +202,12 @@
 		restore_stack = (void (*) (void))get_win32_restore_stack ();
 
 	mono_old_win_toplevel_exception_filter = SetUnhandledExceptionFilter(seh_unhandled_exception_filter);
+#if G_HAVE_API_SUPPORT(HAVE_CLASSIC_WINAPI_SUPPORT)
+	/* AddVectoredExceptionHandler is not declared under the UWP (APP)
+	 * WINAPI family. The vectored handler serves JIT implicit
+	 * null-checks; it is not needed in interpreter mode. */
 	mono_win_vectored_exception_handle = AddVectoredExceptionHandler (1, seh_vectored_exception_handler);
+#endif
 }
 
 void win32_seh_cleanup()
@@ -211,8 +216,10 @@
 
 	if (mono_old_win_toplevel_exception_filter) SetUnhandledExceptionFilter(mono_old_win_toplevel_exception_filter);
 
+#if G_HAVE_API_SUPPORT(HAVE_CLASSIC_WINAPI_SUPPORT)
 	ret = RemoveVectoredExceptionHandler (mono_win_vectored_exception_handle);
 	g_assert (ret);
+#endif
 }
 
 void win32_seh_set_handler(int type, MonoW32ExceptionHandler handler)
